<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors the macOS break window: logo, title, message, Skip. Plus a live seconds countdown. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/overlay_scrim"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:importantForAccessibility="no"
        android:src="@drawable/overlay_logo" />

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:accessibilityHeading="true"
        android:text="@string/overlay_title"
        android:textColor="@android:color/white"
        android:textSize="40sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.2"
        android:maxWidth="420dp"
        android:textColor="#E6FFFFFF"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:accessibilityLiveRegion="none"
        android:fontFeatureSettings="tnum"
        android:textColor="@color/brand"
        android:textSize="56sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/skip"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_skip_button"
        android:minWidth="160dp"
        android:paddingHorizontal="40dp"
        android:stateListAnimator="@null"
        android:text="@string/overlay_skip"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="18sp" />
</LinearLayout>
